# Copy to .env and fill in real values. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call this API / open the
# WebSocket (the frontend's dev/staging/prod URLs).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=15m

# Database (placeholder — wire up to whatever you choose: Postgres/Mongo/etc.)
DATABASE_URL=

# Upstream market data provider (server-side only — never exposed to the browser)
MARKET_DATA_PROVIDER_URL=
MARKET_DATA_PROVIDER_API_KEY=

# How often (ms) the ticker socket pushes a fresh snapshot to clients
TICKER_BROADCAST_INTERVAL_MS=2000
